# Analytics (optional; tracking is fully inert until these are set in Vercel)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Apple Wallet pet ID. Leave unset to hide Add to Apple Wallet.
# The Save to phone image still works. Do not commit certificate files.
# APPLE_WALLET_ENABLED=true
# APPLE_PASS_TYPE_ID=
# APPLE_TEAM_ID=
# APPLE_PASS_CERT_BASE64=
# APPLE_PASS_KEY_BASE64=
# APPLE_WWDR_CERT_BASE64=
# APPLE_PASS_KEY_PASSPHRASE=
# Google Wallet (Generic pass). Test-only until Google approves publishing access.
# GOOGLE_WALLET_ENABLED=true
# GOOGLE_WALLET_ISSUER_ID=
# GOOGLE_WALLET_SA_EMAIL=
# GOOGLE_WALLET_SA_KEY_BASE64=
# Optional: secret for the public pet thumbnail links Google Wallet uses
# WALLET_THUMB_SECRET=
